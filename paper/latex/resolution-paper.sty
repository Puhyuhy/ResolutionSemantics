% Lean declaration names are often long camel-case identifiers.  The local URL
% break set permits breaks after namespace punctuation, underscores, and capital
% letters without changing the source spelling shown to the reader.
\newcommand{\leanname}[1]{%
  \begingroup
  \footnotesize
  \def\UrlBreaks{%
    \do\.\do\_\do\-\do\A\do\B\do\C\do\D\do\E\do\F\do\G\do\H\do\I\do\J%
    \do\K\do\L\do\M\do\N\do\O\do\P\do\Q\do\R\do\S\do\T\do\U\do\V%
    \do\W\do\X\do\Y\do\Z}%
  \nolinkurl{#1}%
  \endgroup
}

